[Unit]
Description=Book Catalog Weather API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weatherapi
WorkingDirectory=/opt/weather-api
Environment=PORT=8081
Environment=WEATHER_CITY=New York
EnvironmentFile=-/etc/weather-api.env
ExecStart=/usr/bin/python3 /opt/weather-api/weather_api.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
